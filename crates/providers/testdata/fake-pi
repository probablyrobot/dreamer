#!/bin/sh
# A scripted stand-in for `pi --mode rpc`, for tests that must run without
# a model or a login. It speaks the subset of pi's RPC protocol Dreamer
# uses (get_state, abort, prompt, extension_ui_response) and answers a
# prompt by what it says:
#
#   "use a tool"   text, a bash tool call, then an approval request (confirm);
#                  the answer finishes the tool call and the turn
#   "work slowly"  text, then nothing until abort, which ends it cancelled
#   anything else  thinking, text, usage, and the end of the turn
#
# FAKE_PI_OLD=1 makes it a pi without get_state. It appends its arguments,
# and whether an API key variable reached it, to fake-pi.log in its agent
# directory.

if [ "$1" = "--version" ]; then
	echo "0.0.0-fake"
	exit 0
fi

log="${PI_CODING_AGENT_DIR:-${TMPDIR:-/tmp}}/fake-pi.log"
printf 'args:%s\n' "$*" >>"$log"
if [ -n "$OPENAI_API_KEY$ANTHROPIC_API_KEY$ANTHROPIC_AUTH_TOKEN$CODEX_API_KEY" ]; then
	echo "key:seen" >>"$log"
else
	echo "key:none" >>"$log"
fi
printf 'session-env:%s\n' "${DREAMER_SESSION_ID:-none}" >>"$log"

sid="fake-$$"
prev=""
for a in "$@"; do
	if [ "$prev" = "--session" ]; then
		sid=$(basename "$a" .jsonl)
	fi
	prev=$a
done
file="${PI_CODING_AGENT_DIR:-/tmp}/sessions/$sid.jsonl"
busy=0

emit() { printf '%s\n' "$1"; }
id_of() { printf '%s' "$1" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p'; }
respond() { emit "{\"id\":\"$1\",\"type\":\"response\",\"command\":\"$2\",\"success\":true$3}"; }
usage='{"input":10,"output":5,"cacheRead":0,"cacheWrite":0,"totalTokens":15,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0.000125}}'
text() { emit "{\"type\":\"message_update\",\"usage\":$usage,\"assistantMessageEvent\":{\"type\":\"$1\",\"contentIndex\":0,\"delta\":\"$2\"}}"; }
finish() {
	emit "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\",\"content\":[],\"stopReason\":\"stop\",\"usage\":$usage}}"
	emit '{"type":"turn_end","message":{"role":"assistant"},"toolResults":[]}'
	emit '{"type":"agent_end","messages":[],"willRetry":false}'
	emit '{"type":"agent_settled","aborted":false}'
	busy=0
}

while IFS= read -r line; do
	id=$(id_of "$line")
	case "$line" in
	*'"type":"get_state"'*)
		if [ "$FAKE_PI_OLD" = 1 ]; then
			emit "{\"id\":\"$id\",\"type\":\"response\",\"command\":\"get_state\",\"success\":false,\"error\":\"Unknown command: get_state\"}"
		else
			respond "$id" get_state ",\"data\":{\"sessionId\":\"$sid\",\"sessionFile\":\"$file\",\"isStreaming\":false,\"messageCount\":0}"
		fi
		;;
	*'"type":"abort"'*)
		if [ $busy = 1 ]; then
			emit "{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\",\"content\":[],\"stopReason\":\"aborted\",\"errorMessage\":\"Request was aborted\"}}"
			emit '{"type":"agent_end","messages":[],"willRetry":false}'
			emit '{"type":"agent_settled","aborted":true}'
			busy=0
		fi
		respond "$id" abort ""
		;;
	*'"type":"prompt"'*)
		# Like pi, the session is kept on disk once it has a message.
		mkdir -p "$(dirname "$file")" && touch "$file"
		respond "$id" prompt ',"data":{"disposition":"started"}'
		emit '{"type":"agent_start"}'
		emit '{"type":"turn_start"}'
		busy=1
		case "$line" in
		*'use a tool'*)
			text text_delta "Let me look."
			emit '{"type":"message_update","usage":{},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"call-1","name":"bash","arguments":{"command":"ls"}}}}'
			emit '{"type":"tool_execution_start","toolCallId":"call-1","toolName":"bash","args":{"command":"ls"}}'
			emit '{"type":"extension_ui_request","id":"ui-1","method":"confirm","title":"Allow bash?","message":"ls"}'
			;;
		*'work slowly'*)
			text text_delta "Working"
			;;
		*)
			text thinking_delta "Thinking."
			text text_delta "Hello from fake pi."
			finish
			;;
		esac
		;;
	*'"type":"extension_ui_response"'*)
		case "$line" in
		*'"confirmed":true'*)
			emit '{"type":"tool_execution_end","toolCallId":"call-1","toolName":"bash","result":{"content":[{"type":"text","text":"file-a"}],"details":{}},"isError":false}'
			;;
		*)
			emit '{"type":"tool_execution_end","toolCallId":"call-1","toolName":"bash","result":{"content":[{"type":"text","text":"blocked by the user"}],"details":{}},"isError":true}'
			;;
		esac
		text text_delta "Done."
		finish
		;;
	*)
		emit "{\"id\":\"$id\",\"type\":\"response\",\"command\":\"unknown\",\"success\":false,\"error\":\"Unknown command\"}"
		;;
	esac
done
