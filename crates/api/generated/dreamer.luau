export type ProcessList = {
	processes: {ProcessRecord}?,
	taken_unix_ms: number?,
}

--- What the daemon pushes, by topic.
export type Notification =
	{ topic: "terminal.records", payload: RecordBatch }
	| { topic: "terminal.checkpoint", payload: CheckpointData }
	| { topic: "terminal.end", payload: SubscriptionEnd }
	| { topic: "tmux.topology", payload: TopologyUpdate }
	| { topic: "events.batch", payload: EventBatch }
	| { topic: "messages.deliver", payload: MessageDelivery }
	| { topic: "taps.data", payload: TapData }

export type Call = (method: string, params: any) -> any

