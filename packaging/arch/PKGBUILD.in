# Maintainer: Dreamer developers
#
# Generated by `cargo xtask package --platform arch` from
# packaging/arch/PKGBUILD.in; the source tarball is `git archive` of the
# packaged revision. The build fetches the pinned Rust toolchain (through
# rustup and rust-toolchain.toml) and the pinned, checksum-verified Zig and
# libghostty-vt sources (cargo xtask deps prepare); see
# docs/dependency-baseline.md.

pkgname=dreamer
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native terminal on tmux with live pane mirrors, typed automation, and scripted panes'
arch=('x86_64' 'aarch64')
url='https://github.com/probablyrobot/dreamer'
license=('Apache-2.0')
depends=('tmux' 'ttf-jetbrains-mono-nerd' 'fontconfig' 'freetype2' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcb' 'wayland' 'vulkan-icd-loader' 'gcc-libs' 'glibc')
optdepends=('ttf-firacode-nerd: the FiraCode Nerd Font Mono family'
            'ttf-hack-nerd: the Hack Nerd Font Mono family'
            'ttf-cascadia-code-nerd: the CaskaydiaCove Nerd Font Mono family'
            'ttf-sourcecodepro-nerd: the SauceCodePro Nerd Font Mono family')
makedepends=('rustup' 'git' 'curl' 'xz' 'pkgconf')
options=('!lto' '!debug')
source=("dreamer-$pkgver.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "dreamer-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
  cargo xtask deps prepare --locked
}

build() {
  cd "dreamer-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  # Keep build paths out of the binaries (makepkg warns about $srcdir).
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --release --locked -p dreamer-app -p dreamer-server -p dreamer-cli
}

check() {
  cd "dreamer-$pkgver"
  ./target/release/dreamerd --self-check
  ./target/release/dream --version
}

package() {
  cd "dreamer-$pkgver"
  install -Dm755 target/release/dreamer target/release/dreamerd target/release/dream -t "$pkgdir/usr/bin"
  install -Dm644 packaging/linux/dev.dreamer.Dreamer.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/icons/dreamer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.dreamer.Dreamer.svg"
  for png in packaging/icons/linux/*.png; do
    size="$(basename "$png" .png)"
    install -Dm644 "$png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/dev.dreamer.Dreamer.png"
  done
  install -Dm644 packaging/linux/dreamerd.service -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 LICENSE NOTICE THIRD_PARTY_NOTICES.md -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname"
}
